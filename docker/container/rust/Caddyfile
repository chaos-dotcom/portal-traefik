# Internal router for the Rust all-in-one image. The Rust service serves BOTH the API and the
# static SPA on one origin (127.0.0.1:8000), so every path proxies to it — no Node process and no
# separate /api split.
{
	servers {
		# Preserve the X-Forwarded-For chain from the hop in front of us. Caddy only *appends* to
		# an incoming XFF when the peer is trusted — otherwise it REPLACES the header with the peer
		# address, as anti-spoofing. Behind a host proxy the peer is the docker bridge gateway
		# (172.x.x.x), so untrusted-by-default meant every forwarded client IP was thrown away here
		# and the API logged the gateway (172.18.0.1) as the downloader. The private ranges are the
		# only addresses that can reach this Caddy from in front: the published port is bound to the
		# host's loopback. In standalone mode Caddy is the edge and real clients arrive from public
		# addresses — untrusted, so their XFF is still replaced with the true peer, as it must be.
		trusted_proxies static private_ranges
	}
}

{$PORTAL_SITE_ADDRESS::80} {
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	@secure expression `{http.request.scheme} == "https"`
	header @secure Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy 127.0.0.1:8000
}
